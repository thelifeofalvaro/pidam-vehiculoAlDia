-- Eliminar columnas innecesarias
alter table usuarios drop column if exists email;
alter table usuarios drop column if exists password_hash;
-- Eliminar FK de Usuarios en Vehiculos
ALTER TABLE vehiculos
DROP CONSTRAINT vehiculos_usuario_id_fkey;
-- Borrar Tabla Usuarios
DROP TABLE usuarios;
-- Crear Tabla Usuarios NUEVA
CREATE TABLE usuarios (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  nombre TEXT,
  rol rol_usuario DEFAULT 'usuario',
  fecha_registro TIMESTAMP DEFAULT NOW()
);
-- Rehacemos la relacion Usuarios - Vehiculos
ALTER TABLE vehiculos
ADD CONSTRAINT vehiculos_usuario_id_fkey
FOREIGN KEY (usuario_id)
REFERENCES usuarios(id)
ON DELETE CASCADE;
